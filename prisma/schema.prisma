// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  MODULE 1 : ENTREPRISES, UTILISATEURS & RÔLES
// ─────────────────────────────────────────────

enum Role {
  ADMIN            // Administrateur de la plateforme
  RESPONSABLE_QHSE // Responsable QHSE de l'entreprise
  EMPLOYE          // Employé déclarant
}

model Entreprise {
  id        String   @id @default(uuid())
  nom       String
  secteur   String?  // Secteur d'activité (BTP, agroalimentaire, etc.)
  adresse   String?
  telephone String?
  email     String?  @unique

  // Relation : une entreprise a plusieurs utilisateurs
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entreprises")
}

model User {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYE)
  actif     Boolean  @default(true)

  // Relation : un utilisateur appartient à une entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  entrepriseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
