// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  MODULE 1 : ENTREPRISES, UTILISATEURS & RÔLES
// ─────────────────────────────────────────────

enum Role {
  ADMIN            // Administrateur de la plateforme
  RESPONSABLE_QHSE // Responsable QHSE de l'entreprise
  EMPLOYE          // Employé déclarant
}

model Entreprise {
  id        String   @id @default(uuid())
  nom       String
  secteur   String?  // Secteur d'activité (BTP, agroalimentaire, etc.)
  adresse   String?
  telephone String?
  email     String?  @unique

  // Relation : une entreprise a plusieurs utilisateurs
  users     User[]
  sites Site[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entreprises")
}

model User {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYE)
  actif     Boolean  @default(true)

  // Relation : un utilisateur appartient à une entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  entrepriseId String

  // Relation : incidents déclarés par cet utilisateur (employé déclarant)
  incidentsDeclares Incident[] @relation("IncidentsDeclares")
  // Relation : incidents validés par cet utilisateur (responsable QHSE)
  incidentsValides  Incident[] @relation("IncidentsValides")
  audits Audit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}


model Site {
  id        String  @id @default(uuid())
  nom       String
  adresse   String?
  ville     String?

  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  entrepriseId String

  incidents Incident[]
  epis Epi[]
  audits Audit[]
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sites")
}

enum TypeIncident {
  ACCIDENT
  PRESQU_ACCIDENT
  SITUATION_DANGEREUSE
  INCIDENT_ENVIRONNEMENTAL
}

enum StatutIncident {
  BROUILLON
  OUVERT
  EN_COURS
  CLOS
  REJETE
}

enum GraviteIncident {
  FAIBLE
  MOYEN
  GRAVE
  CRITIQUE
}

model Incident {
  id              String          @id @default(uuid())
  numeroReference String          @unique @map("numero_reference")
  type            TypeIncident
  description     String
  statut          StatutIncident  @default(BROUILLON)

  latitude        Float?
  longitude       Float?
  adresseLisible  String?         @map("adresse_lisible")
  photoUrl        String?         @map("photo_url")

  gravite         GraviteIncident @default(FAIBLE)

  dateIncident    DateTime        @map("date_incident")
  dateDeclaration DateTime        @default(now()) @map("date_declaration")
  dateCloture     DateTime?       @map("date_cloture")

  declarePar   User    @relation("IncidentsDeclares", fields: [declareParId], references: [id])
  declareParId String  @map("declare_par_id")

  validePar    User?   @relation("IncidentsValides", fields: [valideParId], references: [id])
  valideParId  String? @map("valide_par_id")

  site         Site    @relation(fields: [siteId], references: [id])
  siteId       String  @map("site_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("incidents")
}

// ─────────────────────────────────────────────
//  MODULE 3 : GESTION DES EPI
//  (Équipements de Protection Individuelle)
// ─────────────────────────────────────────────

enum StatutEpi {
  DISPONIBLE      // En stock, utilisable
  EN_RUPTURE      // Stock épuisé
  PERIME          // Date de péremption dépassée
  COMMANDE        // En cours de commande
}

model Epi {
  id          String     @id @default(uuid())
  designation String                              // Ex: Casque de chantier
  type        String                              // Ex: Protection tête
  reference   String?                             // Référence fournisseur
  quantite    Int        @default(0)              // Stock disponible
  seuilAlerte Int        @default(5)              // Seuil de réapprovisionnement
  statut      StatutEpi  @default(DISPONIBLE)
  datePeremption DateTime? @map("date_peremption") // Optionnel (certains EPI expirent)

  // Relation : l'EPI est rattaché à un site
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("epis")
}

// ─────────────────────────────────────────────
//  MODULE 4 : AUDITS INTERNES
// ─────────────────────────────────────────────

enum TypeAudit {
  SECURITE       // Audit sécurité
  QUALITE        // Audit qualité
  ENVIRONNEMENT  // Audit environnemental
  HYGIENE        // Audit hygiène
}

enum StatutAudit {
  PLANIFIE   // Audit programmé
  EN_COURS   // Audit en cours de réalisation
  TERMINE    // Audit clôturé
  ANNULE     // Audit annulé
}

model Audit {
  id          String      @id @default(uuid())
  reference   String      @unique @map("reference")  // Ex: AUD-2026-0001
  titre       String
  type        TypeAudit
  statut      StatutAudit @default(PLANIFIE)
  datePrevue  DateTime    @map("date_prevue")          // Date planifiée
  dateRealisee DateTime?  @map("date_realisee")        // Date réelle (optionnel)
  scoreConformite Float?  @map("score_conformite")     // Score en % (0-100)
  observations String?                                  // Commentaires de l'auditeur

  // Relation : l'auditeur (utilisateur qui réalise l'audit)
  auditeur   User   @relation(fields: [auditeurId], references: [id])
  auditeurId String @map("auditeur_id")

  // Relation : le site audité
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audits")
}
