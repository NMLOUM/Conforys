// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  MODULE 1 : ENTREPRISES, UTILISATEURS & RÔLES
// ─────────────────────────────────────────────

enum Role {
  ADMIN // Administrateur de la plateforme
  RESPONSABLE_QHSE // Responsable QHSE de l'entreprise
  EMPLOYE // Employé déclarant
}

model Entreprise {
  id        String  @id @default(uuid())
  nom       String
  secteur   String? // Secteur d'activité (BTP, agroalimentaire, etc.)
  adresse   String?
  telephone String?
  email     String? @unique

  // Relation : une entreprise a plusieurs utilisateurs
  users User[]
  sites Site[]
  historiqueAssistant HistoriqueAssistant[]

  // Dernière date à laquelle le DUERP a été formellement révisé (obligation
  // légale : révision au moins annuelle). Alimente le calcul de l'échéance
  // de la prochaine révision (dateDerniereRevisionDuerp + 1 an).
  dateDerniereRevisionDuerp DateTime? @map("date_derniere_revision_duerp")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("entreprises")
}

model User {
  id       String  @id @default(uuid())
  nom      String
  prenom   String
  email    String  @unique
  password String
  role     Role    @default(EMPLOYE)
  actif    Boolean @default(true)

  // Relation : un utilisateur appartient à une entreprise
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  entrepriseId String

  // Site de rattachement de l'employé pour limiter sa consultation DUERP
  site   Site?  @relation(fields: [siteId], references: [id])
  siteId String? @map("site_id")

  historiqueAssistant HistoriqueAssistant[]

  // Relation : incidents déclarés par cet utilisateur (employé déclarant)
  incidentsDeclares            Incident[]               @relation("IncidentsDeclares")
  // Relation : incidents validés par cet utilisateur (responsable QHSE)
  incidentsValides             Incident[]               @relation("IncidentsValides")
  // Relation : incidents assignés à cet utilisateur pour traitement
  incidentsAssignes            Incident[]               @relation("IncidentsAssignes")
  audits                       Audit[]
  // Relation : participations aux formations (présence, validation)
  participationsFormation      ParticipationFormation[] @relation("ParticipantsFormation")
  // Relation : habilitations détenues par cet utilisateur
  habilitations                Habilitation[]
  // Relation : actions correctives assignées à cet utilisateur
  actionsAssignees             ActionCorrective[]       @relation("ActionsAssignees")
  // Relation : entrées d'historique dont cet utilisateur est l'auteur
  historiqueActions            HistoriqueIncident[]     @relation("HistoriqueAuteur")
  // Relation : notifications reçues par cet utilisateur
  notifications                Notification[]
  // Relation : EPI actuellement ou anciennement affectés à cet utilisateur
  episAffectes                 AffectationEpi[]         @relation("EpisAffectes")
  // Relation : inspections d'EPI réalisées par cet utilisateur
  inspectionsEffectuees        InspectionEpi[]          @relation("InspectionsEffectuees")
  // Relation : entrées du journal EPI dont cet utilisateur est l'auteur
  historiqueEpis               HistoriqueEpi[]          @relation("HistoriqueEpiAuteur")
  // Relation : attestations de formation obtenues
  attestations                 Attestation[]
  // Relation : risques professionnels identifiés par cet utilisateur (DUERP)
  risquesIdentifies            Risque[]
  // Relation : entrées d'historique DUERP dont cet utilisateur est l'auteur
  historiqueRisques            HistoriqueRisque[]       @relation("HistoriqueRisqueAuteur")
  // Relation : analyses de causes racines réalisées par cet utilisateur
  analysesCauses               AnalyseCauses[]
  // Relation : pièces jointes ajoutées par cet utilisateur (espace collaboratif)
  piecesJointesAjoutees        PieceJointe[]            @relation("PiecesJointesAjoutees")
  // Relation : commentaires postés par cet utilisateur (espace collaboratif)
  commentaires                 Commentaire[]            @relation("CommentairesAuteur")
  // Relation : entrées du journal d'audit des actions correctives dont cet utilisateur est l'auteur
  historiqueActionsCorrectives HistoriqueAction[]       @relation("HistoriqueActionAuteur")
  // Relation : commentaires postés sur une action corrective (espace collaboratif CAPA)
  commentairesAction           CommentaireAction[]      @relation("CommentairesActionAuteur")
  // Relation : pièces jointes ajoutées sur une action corrective
  piecesJointesActionAjoutees  PieceJointeAction[]      @relation("PiecesJointesActionAjoutees")
  // Relation : entrées d'historique d'audit dont cet utilisateur est l'auteur
  historiqueAudits             HistoriqueAudit[]        @relation("HistoriqueAuditAuteur")
  // Relation : entrées d'historique de formation dont cet utilisateur est l'auteur
  historiqueFormations         HistoriqueFormation[]    @relation("HistoriqueFormationAuteur")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model HistoriqueAssistant {
  id           String     @id @default(uuid())
  question     String
  reponse      String
  createdAt    DateTime   @default(now()) @map("created_at")

  utilisateur   User       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String     @map("utilisateur_id")
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId  String     @map("entreprise_id")

  @@index([utilisateurId, createdAt])
  @@index([entrepriseId, createdAt])
  @@map("historique_assistant")
}

model Site {
  id      String  @id @default(uuid())
  nom     String
  adresse String?
  ville   String?

  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  entrepriseId String

  users User[]

  incidents  Incident[]
  epis       Epi[]
  audits     Audit[]
  formations Formation[]
  risques    Risque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sites")
}

enum TypeIncident {
  ACCIDENT
  PRESQU_ACCIDENT
  SITUATION_DANGEREUSE
  INCIDENT_ENVIRONNEMENTAL
}

enum StatutIncident {
  BROUILLON
  OUVERT
  EN_COURS
  CLOS
  REJETE
}

enum GraviteIncident {
  FAIBLE
  MOYEN
  GRAVE
  CRITIQUE
}

model Incident {
  id              String         @id @default(uuid())
  numeroReference String         @unique @map("numero_reference")
  type            TypeIncident
  description     String
  statut          StatutIncident @default(BROUILLON)

  latitude       Float?
  longitude      Float?
  adresseLisible String? @map("adresse_lisible")
  photoUrl       String? @map("photo_url")

  gravite GraviteIncident @default(FAIBLE)

  dateIncident    DateTime  @map("date_incident")
  dateDeclaration DateTime  @default(now()) @map("date_declaration")
  dateCloture     DateTime? @map("date_cloture")
  motifRejet      String?   @map("motif_rejet")

  declarePar   User   @relation("IncidentsDeclares", fields: [declareParId], references: [id])
  declareParId String @map("declare_par_id")

  validePar   User?   @relation("IncidentsValides", fields: [valideParId], references: [id])
  valideParId String? @map("valide_par_id")

  // Employé assigné pour le traitement de l'incident — renseigné en même
  // temps que la validation (OUVERT → EN_COURS), jamais avant
  assigneA   User?   @relation("IncidentsAssignes", fields: [assigneAId], references: [id])
  assigneAId String? @map("assigne_a_id")

  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  // Relation : actions correctives liées à cet incident
  actionsCorrectives ActionCorrective[]
  // Relation : pièces jointes liées à cet incident
  piecesJointes      PieceJointe[]
  // Relation : piste d'audit (suppression en cascade avec l'incident)
  historique         HistoriqueIncident[]
  // Relation : analyse des causes racines (5 Pourquoi + Ishikawa), une seule par incident
  analyseCauses      AnalyseCauses?
  // Relation : commentaires de l'espace collaboratif (suppression en cascade)
  commentaires       Commentaire[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("incidents")
}

// ─────────────────────────────────────────────
//  MODULE 2a-bis : PISTE D'AUDIT (HISTORIQUE)
// ─────────────────────────────────────────────

model HistoriqueIncident {
  id      String  @id @default(uuid())
  action  String // Ex: "Incident déclaré", "Statut changé : OUVERT → EN_COURS"
  details String? // Précision optionnelle (motif rejet, nom photo, etc.)

  // Suppression en cascade : si l'incident est supprimé, son historique disparaît aussi
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String   @map("incident_id")

  // Auteur de l'action (lecture seule, jamais supprimé côté historique)
  auteur   User   @relation("HistoriqueAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_incidents")
}

// ─────────────────────────────────────────────
//  MODULE 2b : ACTIONS CORRECTIVES (CAPA)
// ─────────────────────────────────────────────

enum PrioriteAction {
  FAIBLE
  MOYEN
  ELEVE
  CRITIQUE
}

enum StatutAction {
  A_FAIRE
  EN_COURS
  TERMINE
  ANNULE
}

model ActionCorrective {
  id                 String         @id @default(uuid())
  description        String
  priorite           PrioriteAction @default(MOYEN)
  statut             StatutAction   @default(A_FAIRE)
  dateLimite         DateTime?      @map("date_limite")
  dateCloture        DateTime?      @map("date_cloture")
  commentaireCloture String?        @map("commentaire_cloture")

  // Relation : liée à un incident (optionnelle — une action peut venir d'un
  // incident OU d'un audit, jamais des deux ; contrôlé au niveau service)
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String?   @map("incident_id")

  // Relation : liée à un audit (générée automatiquement depuis une non-conformité)
  audit   Audit?  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String? @map("audit_id")

  // Relation : liée à un risque du DUERP (générée pour un risque élevé/critique)
  risque   Risque? @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  risqueId String? @map("risque_id")

  // Relation : responsable assigné
  responsable   User   @relation("ActionsAssignees", fields: [responsableId], references: [id])
  responsableId String @map("responsable_id")

  // Relation : checklist des étapes de résolution (page de détail CAPA)
  etapes        EtapeAction[]
  // Relation : journal d'audit propre à l'action (piste de traçabilité immuable)
  historique    HistoriqueAction[]
  // Relation : fil de commentaires propre à l'action
  commentaires  CommentaireAction[]
  // Relation : pièces jointes propres à l'action (photos, documents)
  piecesJointes PieceJointeAction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("actions_correctives")
}

// ── Page de détail CAPA : checklist, journal d'audit, commentaires, pièces jointes ──

// Une étape de la checklist de résolution d'une action corrective.
// Remplace-tout côté service à chaque écriture (même logique que les causes
// Ishikawa/étapes 5 Pourquoi) : pas d'enjeu d'audit individuel par étape,
// seule la complétion globale (progression %) compte pour l'affichage.
model EtapeAction {
  id       String  @id @default(uuid())
  libelle  String
  complete Boolean @default(false)
  ordre    Int     @default(0)

  action   ActionCorrective @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String           @map("action_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("etapes_action")
}

// Piste d'audit immuable propre à une action corrective — même principe que
// HistoriqueIncident/HistoriqueRisque (une entrée par événement métier :
// création, changement de statut, étape complétée, clôture).
model HistoriqueAction {
  id      String  @id @default(uuid())
  action  String // Libellé métier libre : "Action créée", "Statut changé : X → Y", "Étape complétée : ..."
  details String?

  actionCorrective   ActionCorrective @relation(fields: [actionCorrectiveId], references: [id], onDelete: Cascade)
  actionCorrectiveId String           @map("action_corrective_id")

  auteur   User   @relation("HistoriqueActionAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_actions")
}

// Fil de commentaires propre à une action corrective (espace collaboratif CAPA).
model CommentaireAction {
  id      String @id @default(uuid())
  contenu String

  action   ActionCorrective @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String           @map("action_id")

  auteur   User   @relation("CommentairesActionAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("commentaires_action")
}

// Pièces jointes propres à une action corrective (photos/documents de résolution).
model PieceJointeAction {
  id     String          @id @default(uuid())
  url    String
  nom    String?
  type   TypePieceJointe @default(IMAGE)
  taille Int?

  action   ActionCorrective @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String           @map("action_id")

  ajoutePar   User?   @relation("PiecesJointesActionAjoutees", fields: [ajouteParId], references: [id])
  ajouteParId String? @map("ajoute_par_id")

  dateAjout DateTime @default(now()) @map("date_ajout")

  @@map("pieces_jointes_action")
}

// ─────────────────────────────────────────────
//  MODULE 2d : ANALYSE DES CAUSES RACINES (5 Pourquoi + Ishikawa 5M)
// ─────────────────────────────────────────────

// Une analyse par incident : recense le problème (l'effet), la cause racine
// retenue à l'issue de l'analyse, et sert de parent aux causes Ishikawa et
// aux étapes des 5 Pourquoi.
model AnalyseCauses {
  id              String    @id @default(uuid())
  probleme        String // Pré-rempli avec incident.description à la création
  causeRacine     String?   @map("cause_racine") // Renseignée à l'issue de l'analyse
  valideLe        DateTime? @map("valide_le") // Date de validation ("Valider l'analyse") — null tant que non validée
  actionGenereeLe DateTime? @map("action_generee_le") // Empêche de générer deux fois l'action corrective depuis la même analyse

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String   @unique @map("incident_id")

  auteur   User   @relation(fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  causesIshikawa CauseIshikawa[]
  etapesPourquoi EtapePourquoi[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("analyses_causes")
}

// Catégories du diagramme d'Ishikawa (5M)
enum Categorie5M {
  MAIN_OEUVRE
  MATERIEL
  METHODE
  MILIEU
  MATIERE
}

// Une cause potentielle rattachée à l'une des 5 branches du diagramme
// d'Ishikawa. `retenue` marque les causes cochées comme pertinentes par le
// QHSE (mises en évidence côté frontend), sans en faire pour autant LA cause
// racine (qui reste un champ texte libre sur AnalyseCauses.causeRacine).
model CauseIshikawa {
  id        String      @id @default(uuid())
  categorie Categorie5M
  libelle   String
  retenue   Boolean     @default(false)

  analyse   AnalyseCauses @relation(fields: [analyseId], references: [id], onDelete: Cascade)
  analyseId String        @map("analyse_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("causes_ishikawa")
}

// Une étape de la cascade des "5 Pourquoi" (ordre 1 à 5). La dernière étape
// renseignée représente la cause profonde, mise en évidence côté frontend.
model EtapePourquoi {
  id       String @id @default(uuid())
  ordre    Int
  question String
  reponse  String

  analyse   AnalyseCauses @relation(fields: [analyseId], references: [id], onDelete: Cascade)
  analyseId String        @map("analyse_id")

  @@map("etapes_pourquoi")
}

// ─────────────────────────────────────────────
//  MODULE 2c : PIÈCES JOINTES DES INCIDENTS
// ─────────────────────────────────────────────

enum TypePieceJointe {
  IMAGE
  DOCUMENT
}

model PieceJointe {
  id     String          @id @default(uuid())
  url    String // URL hébergée sur ImgBB
  nom    String? // Nom original du fichier
  type   TypePieceJointe @default(IMAGE)
  taille Int? // Taille en octets, si connue (affichage espace collaboratif)

  // Relation : liée à un incident (suppression en cascade)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String   @map("incident_id")

  // Relation : utilisateur ayant ajouté la pièce — nécessaire pour autoriser
  // sa propre suppression sans être QHSE/ADMIN (voir pieceJointeService)
  ajoutePar   User?   @relation("PiecesJointesAjoutees", fields: [ajouteParId], references: [id])
  ajouteParId String? @map("ajoute_par_id")

  dateAjout DateTime @default(now()) @map("date_ajout")

  @@map("pieces_jointes")
}

// ── Commentaires (espace collaboratif d'un incident) ─────────────────────────
model Commentaire {
  id      String @id @default(uuid())
  contenu String

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String   @map("incident_id")

  auteur   User   @relation("CommentairesAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("commentaires")
}

// ─────────────────────────────────────────────
//  MODULE 3 : GESTION DES EPI
//  (Équipements de Protection Individuelle)
// ─────────────────────────────────────────────

enum StatutEpi {
  DISPONIBLE // En stock, utilisable
  EN_RUPTURE // Stock épuisé
  PERIME // Date de péremption dépassée
  COMMANDE // En cours de commande
}

model Epi {
  id                       String    @id @default(uuid())
  designation              String // Ex: Casque de chantier
  type                     String // Ex: Protection tête
  reference                String? // Référence fournisseur
  photoUrl                 String?   @map("photo_url") // URL de la photo (hébergée sur ImgBB)
  quantite                 Int       @default(0) // Stock disponible
  seuilAlerte              Int       @default(5) // Seuil de réapprovisionnement
  statut                   StatutEpi @default(DISPONIBLE)
  datePeremption           DateTime? @map("date_peremption") // Optionnel (certains EPI expirent)
  frequenceInspectionJours Int?      @map("frequence_inspection_jours") // Optionnel : périodicité d'inspection requise (ex: 180 = tous les 6 mois)

  // Relation : l'EPI est rattaché à un site
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  // Relation : affectations de cet EPI à des employés
  affectations AffectationEpi[]

  // Relation : historique des inspections de cet EPI
  inspections InspectionEpi[]

  // Relation : journal complet des actions effectuées sur cet EPI
  historique HistoriqueEpi[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("epis")
}

// ─────────────────────────────────────────────
//  MODULE 3c : HISTORIQUE DES INSPECTIONS D'EPI
// ─────────────────────────────────────────────

// Une inspection est un événement daté et immuable (contrairement à
// dateDerniereInspection auparavant stocké sur l'Epi, qui était écrasé à
// chaque inspection et ne conservait aucun historique).
model InspectionEpi {
  id             String   @id @default(uuid())
  dateInspection DateTime @default(now()) @map("date_inspection")
  conforme       Boolean  @default(true) // L'EPI a-t-il passé l'inspection ?
  commentaire    String?

  // Relation : l'EPI inspecté (suppression en cascade avec l'EPI)
  epi   Epi    @relation(fields: [epiId], references: [id], onDelete: Cascade)
  epiId String @map("epi_id")

  // Relation : l'utilisateur ayant réalisé l'inspection (optionnel)
  inspecteur   User?   @relation("InspectionsEffectuees", fields: [inspecteurId], references: [id])
  inspecteurId String? @map("inspecteur_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("inspections_epi")
}

// ─────────────────────────────────────────────
//  MODULE 3b : AFFECTATION DES EPI AUX EMPLOYÉS
// ─────────────────────────────────────────────

enum StatutAffectation {
  ACTIVE // EPI actuellement remis à l'employé
  RENDUE // EPI restitué
}

model AffectationEpi {
  id              String            @id @default(uuid())
  poste           String? // Poste de travail concerné
  dateAffectation DateTime          @default(now()) @map("date_affectation")
  dateRetour      DateTime?         @map("date_retour")
  statut          StatutAffectation @default(ACTIVE)

  // Relation : l'EPI affecté (suppression en cascade avec l'EPI)
  epi   Epi    @relation(fields: [epiId], references: [id], onDelete: Cascade)
  epiId String @map("epi_id")

  // Relation : l'employé à qui l'EPI est affecté
  employe   User   @relation("EpisAffectes", fields: [employeId], references: [id])
  employeId String @map("employe_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("affectations_epi")
}

// ─────────────────────────────────────────────
//  MODULE 3d : HISTORIQUE DES EPI (JOURNAL COMPLET)
// ─────────────────────────────────────────────

// Journal unique regroupant TOUTES les actions liées à un EPI (création,
// modification, suppression, affectation, retour, inspection) — même principe
// que HistoriqueIncident/HistoriqueAction : une entrée immuable par
// événement métier, texte libre, pas de table polymorphique.
model HistoriqueEpi {
  id      String  @id @default(uuid())
  action  String // Ex: "EPI créé", "EPI affecté", "Inspection enregistrée"
  details String? // Précision optionnelle (employé concerné, commentaire d'inspection, etc.)

  // Suppression en cascade : si l'EPI est supprimé, son historique disparaît aussi
  epi   Epi    @relation(fields: [epiId], references: [id], onDelete: Cascade)
  epiId String @map("epi_id")

  // Auteur de l'action (lecture seule, jamais supprimé côté historique)
  auteur   User   @relation("HistoriqueEpiAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_epis")
}

// ─────────────────────────────────────────────
//  MODULE 4 : AUDITS INTERNES
// ─────────────────────────────────────────────

enum TypeAudit {
  SECURITE // Audit sécurité
  QUALITE // Audit qualité
  ENVIRONNEMENT // Audit environnemental
  HYGIENE // Audit hygiène
}

enum StatutAudit {
  PLANIFIE // Audit programmé
  EN_COURS // Audit en cours de réalisation
  TERMINE // Audit clôturé
  ANNULE // Audit annulé
}

model Audit {
  id              String      @id @default(uuid())
  reference       String      @unique @map("reference") // Ex: AUD-2026-0001
  titre           String
  type            TypeAudit
  statut          StatutAudit @default(PLANIFIE)
  datePrevue      DateTime    @map("date_prevue") // Date planifiée
  dateRealisee    DateTime?   @map("date_realisee") // Date réelle (optionnel)
  scoreConformite Float?      @map("score_conformite") // Score en % (0-100)
  observations    String? // Commentaires de l'auditeur

  // Relation : l'auditeur (utilisateur qui réalise l'audit)
  auditeur   User   @relation(fields: [auditeurId], references: [id])
  auditeurId String @map("auditeur_id")

  // Relation : le site audité
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  // Relation : questions de la checklist (générées depuis un template à la création)
  questions QuestionAudit[]

  // Relation : actions correctives générées depuis les non-conformités de l'audit
  actionsCorrectives ActionCorrective[]

  // Relation : historique / piste d'audit de cet audit (créé, démarré, question répondue, finalisé...)
  historique HistoriqueAudit[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audits")
}

// Piste d'audit d'un audit — même principe que HistoriqueIncident/HistoriqueRisque :
// une ligne libre par événement (création, démarrage, réponse à une question,
// finalisation, génération du plan d'actions), horodatée et attribuée à un auteur.
model HistoriqueAudit {
  id      String  @id @default(uuid())
  action  String // Ex: "Audit créé", "Audit démarré", "Statut changé : EN_COURS → TERMINE"
  details String?

  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String @map("audit_id")

  auteur   User   @relation("HistoriqueAuditAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_audits")
}

// ── Checklist d'audit : questions et scoring pondéré ──────────────────────────

enum CriticiteQuestion {
  CRITIQUE // Poids 3 dans le calcul du score
  MAJEUR // Poids 2
  MINEUR // Poids 1
}

enum ReponseAudit {
  CONFORME // Compte pour le score
  NON_CONFORME // Compte pour le score, commentaire obligatoire
  NON_APPLICABLE // Exclue du dénominateur du score
  NON_REPONDU // Exclue du dénominateur du score (valeur initiale)
}

model QuestionAudit {
  id          String            @id @default(uuid())
  libelle     String
  criticite   CriticiteQuestion @default(MAJEUR)
  reponse     ReponseAudit      @default(NON_REPONDU)
  commentaire String?
  photoUrl    String?           @map("photo_url")
  // Position dans le template d'origine — createdAt seul n'est pas fiable
  // pour l'ordre : toutes les questions d'un même audit sont créées dans la
  // même transaction et partagent donc un horodatage identique.
  ordre       Int               @default(0)

  // Suppression en cascade : les questions n'ont pas de sens sans leur audit parent
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId String @map("audit_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("questions_audit")
}

// ─────────────────────────────────────────────
//  MODULE 5 : FORMATIONS
// ─────────────────────────────────────────────

enum StatutFormation {
  PLANIFIEE // Formation programmée
  EN_COURS // Formation en cours de réalisation
  TERMINEE // Formation clôturée
  ANNULEE // Formation annulée
}

enum ThemeFormation {
  INCENDIE
  EPI
  RISQUES_ELECTRIQUES
  DECHETS
  PREMIERS_SECOURS
  TRAVAIL_HAUTEUR
  ACCUEIL_SECURITE // Induction sécurité des nouveaux arrivants (employés, sous-traitants, visiteurs)
}

model Formation {
  id                 String          @id @default(uuid())
  titre              String
  description        String?
  formateur          String
  theme              ThemeFormation?
  statut             StatutFormation @default(PLANIFIEE)
  dateDebut          DateTime        @map("date_debut")
  dateFin            DateTime?       @map("date_fin")
  dureeHeures        Float?          @map("duree_heures")
  dureeValiditeJours Int?            @map("duree_validite_jours") // Optionnel : périodicité de recyclage requise (ex: 365 = 1 an) — sert à calculer la date d'expiration de l'attestation délivrée

  // Relation : la formation se déroule sur un site
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  // Relation : participations des utilisateurs à cette formation (présence,
  // validation) — remplace l'ancienne relation many-to-many "participants"
  participations ParticipationFormation[]

  // Relation : historique / piste d'audit de cette session (créée, démarrée,
  // présence marquée, participant validé, terminée, annulée...)
  historique HistoriqueFormation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("formations")
}

// Piste d'audit d'une session de formation — même principe que les autres
// modules : une ligne libre par événement, horodatée et attribuée à un auteur.
model HistoriqueFormation {
  id      String  @id @default(uuid())
  action  String // Ex: "Session créée", "Présence marquée : Cheikh FALL", "Statut changé : PLANIFIEE → EN_COURS"
  details String?

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String    @map("formation_id")

  auteur   User   @relation("HistoriqueFormationAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_formations")
}

// Table de jointure explicite (remplace l'ancienne M2M implicite) : porte le
// suivi de présence et de validation par participant, propre à chaque session.
model ParticipationFormation {
  id             String    @id @default(uuid())
  present        Boolean   @default(false)
  valide         Boolean   @default(false)
  dateValidation DateTime? @map("date_validation")

  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String    @map("formation_id")

  participant   User   @relation("ParticipantsFormation", fields: [participantId], references: [id])
  participantId String @map("participant_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un utilisateur ne peut être inscrit qu'une seule fois à une même session
  @@unique([formationId, participantId])
  @@map("participations_formation")
}

// ─────────────────────────────────────────────
//  MODULE 5c : ATTESTATIONS DE FORMATION
// ─────────────────────────────────────────────
//
// Certificat délivré automatiquement quand un employé est validé sur une
// session présentielle (sous-bloc A) ou réussit un quiz de module en ligne
// (sous-bloc B). Volontairement DÉCOUPLÉE de Formation/ModuleFormation (pas
// de clé étrangère) : l'attestation est un document permanent qui doit rester
// consultable/vérifiable même si la formation source est plus tard modifiée
// ou supprimée — d'où les champs texte dénormalisés (titreFormation, etc.).

enum SourceAttestation {
  SESSION // Issue d'une session présentielle (sous-bloc A)
  MODULE_EN_LIGNE // Issue d'un module en ligne / quiz (sous-bloc B)
}

model Attestation {
  id               String            @id @default(uuid())
  codeVerification String            @unique @map("code_verification") // Code public, distinct de l'id interne
  titreFormation   String            @map("titre_formation")
  themeFormation   String?           @map("theme_formation")
  dateObtention    DateTime          @default(now()) @map("date_obtention")
  dateExpiration   DateTime?         @map("date_expiration") // Optionnel : formations à recycler périodiquement
  scoreObtenu      Int?              @map("score_obtenu") // Renseigné si issue d'un quiz
  source           SourceAttestation

  beneficiaire   User   @relation(fields: [beneficiaireId], references: [id])
  beneficiaireId String @map("beneficiaire_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("attestations")
}

// ─────────────────────────────────────────────
//  MODULE 6 : HABILITATIONS
// ─────────────────────────────────────────────

enum StatutHabilitation {
  VALIDE // Habilitation en cours de validité
  EXPIREE // Date d'expiration dépassée
  BIENTOT_EXPIREE // Expire dans moins de 30 jours
}

model Habilitation {
  id             String             @id @default(uuid())
  intitule       String // Ex: Habilitation électrique B1V
  type           String // Ex: Electrique, Chimique, Hauteur
  niveau         String? // Ex: B1, B2, BR...
  dateObtention  DateTime           @map("date_obtention")
  dateExpiration DateTime           @map("date_expiration")
  statut         StatutHabilitation @default(VALIDE)

  // Relation : le titulaire de l'habilitation
  titulaire   User   @relation(fields: [titulaireId], references: [id])
  titulaireId String @map("titulaire_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("habilitations")
}

// ─────────────────────────────────────────────
//  MODULE 7 : NOTIFICATIONS IN-APP
// ─────────────────────────────────────────────

enum TypeNotification {
  INCIDENT_DECLARE // Incident déclaré, notifié aux QHSE de l'entreprise
  INCIDENT_CRITIQUE // Idem, mais gravité CRITIQUE (titre plus urgent)
  INCIDENT_ASSIGNE // Incident assigné à un employé pour traitement (validation QHSE)
  EPI_STOCK_BAS // EPI sous le seuil d'alerte
  HABILITATION_EXPIRE // Habilitation expirant bientôt
  ACTION_EN_RETARD // Action corrective en retard
  ACTION_ASSIGNEE // Action corrective assignée à un responsable
  AUDIT_PLANIFIE // Audit planifié à venir
}

model Notification {
  id      String           @id @default(uuid())
  type    TypeNotification
  titre   String
  message String
  lu      Boolean          @default(false)
  lien    String? // Ex: /incidents/:id — route frontend cible

  // Relation : destinataire de la notification (suppression en cascade avec l'utilisateur)
  destinataire   User   @relation(fields: [destinataireId], references: [id], onDelete: Cascade)
  destinataireId String @map("destinataire_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ─────────────────────────────────────────────
//  MODULE 8 : DUERP (ÉVALUATION DES RISQUES PROFESSIONNELS)
// ─────────────────────────────────────────────

enum CategorieRisque {
  CHUTE
  ELECTRIQUE
  CHIMIQUE
  MECANIQUE
  INCENDIE
  BRUIT
  MANUTENTION
  THERMIQUE
  BIOLOGIQUE
  AUTRE
}

// Une ligne du Document Unique d'Évaluation des Risques Professionnels.
// La cotation (probabilité × gravité) et son niveau qualitatif ne sont
// jamais recalculés côté frontend : niveauRisque/niveauResiduel sont stockés
// pour rester des valeurs figées au moment de la saisie, cohérentes avec
// l'historique du document même si l'échelle de calcul évoluait plus tard.
model Risque {
  id          String          @id @default(uuid())
  danger      String // Ex: "Chute de hauteur"
  description String?
  categorie   CategorieRisque @default(AUTRE)
  zone        String? // Ex: "Atelier soudure"

  probabilite  Int // 1 (rare) à 4 (fréquent)
  gravite      Int // 1 (mineure) à 4 (critique)
  niveauRisque Int @map("niveau_risque") // = probabilite × gravite, 1 à 16

  mesuresPrevention String? @map("mesures_prevention")

  // Cotation résiduelle — après application des mesures de prévention (optionnelle)
  probabiliteResiduelle Int? @map("probabilite_residuelle")
  graviteResiduelle     Int? @map("gravite_residuelle")
  niveauResiduel        Int? @map("niveau_residuel")

  // Relation : site/atelier concerné par ce risque
  site   Site   @relation(fields: [siteId], references: [id])
  siteId String @map("site_id")

  // Relation : utilisateur ayant identifié/saisi ce risque
  auteur   User   @relation(fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  // Relation : actions de prévention générées à partir de ce risque
  actions ActionCorrective[]

  // Relation : piste d'audit des modifications apportées à ce risque
  historique HistoriqueRisque[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("risques")
}

// Piste d'audit immuable des changements apportés à un risque (création,
// modification de cotation, mesures de prévention, génération d'action) —
// même principe que HistoriqueIncident, nécessaire à la traçabilité exigée
// du DUERP (obligation de conserver les versions successives du document).
model HistoriqueRisque {
  id       String @id @default(uuid())
  risque   Risque @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  risqueId String @map("risque_id")

  auteur   User   @relation("HistoriqueRisqueAuteur", fields: [auteurId], references: [id])
  auteurId String @map("auteur_id")

  action  String // Libellé métier libre : "Risque identifié", "Cotation modifiée : 8 → 4", "Mesures de prévention mises à jour", "Action de prévention générée"
  details String?

  dateAction DateTime @default(now()) @map("date_action")

  @@map("historique_risques")
}
